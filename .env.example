RUNPOD_API_KEY=

# LLM Configuration
LLM_ENDPOINT_URL=https://runpod-id-8000.proxy.runpod.net
LLM_MODEL_ID=your-llm-id
LLM_MODEL_NAME=TheBloke/Mistral-7B-Instruct-v0.1-AWQ
LLM_MAX_TOKENS=100
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# Concurrency Configuration
MAX_CONCURRENT=100
REQUEST_DELAY=0.02
MAX_RETRIES=2
TIMEOUT_TOTAL=60
TIMEOUT_CONNECT=10

# Test Configuration
PERSONA_COUNT=100
PERSONAS_FILE=personas.json
RESULTS_PREFIX=results/market_research_results

# Debug Mode (optional)
DEBUG=false
