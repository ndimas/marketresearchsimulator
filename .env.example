RUNPOD_API_KEY=

# LLM Configuration
LLM_ENDPOINT_URL=https://runpod-id-8000.proxy.runpod.net
LLM_MODEL_ID=your-llm-id
LLM_MODEL_NAME=your-llm-name
LLM_MAX_TOKENS=100
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# Concurrency Configuration
MAX_CONCURRENT=150
REQUEST_DELAY=0.02
MAX_RETRIES=2
TIMEOUT_TOTAL=60
TIMEOUT_CONNECT=10

# Test Configuration
QUESTIONS_PER_RUN=3
PERSONA_COUNT=150
PERSONAS_FILE=personas.json
RESULTS_PREFIX=results/market_research_results

# Debug Mode (optional)
DEBUG=false
